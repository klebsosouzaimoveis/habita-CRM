label{font-size:7.5pt;font-weight:700;color:var(--navy)}
input,select,textarea{width:100%;border:1px solid #9eb5ca;border-radius:1.5mm;padding:2mm 2.2mm;font:9pt Arial;color:var(--ink);background:#fff;min-height:8mm;outline:none}
