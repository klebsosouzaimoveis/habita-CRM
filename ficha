<script>
// Configure these public values before publishing. The server secret belongs
// only in Supabase Edge Function secrets, never in this HTML.
const EDGE_FUNCTION_URL='';
const TURNSTILE_SITE_KEY='';
const SUPABASE_PUBLISHABLE_KEY='';
if(TURNSTILE_SITE_KEY){const widget=document.getElementById('turnstile-widget');widget.hidden=false;const render=()=>{if(window.turnstile&&!widget.dataset.rendered){window.turnstile.render(widget,{sitekey:TURNSTILE_SITE_KEY});widget.dataset.rendered='1';}};if(window.turnstile)render();else document.querySelector('script[src*="challenges.cloudflare.com"]').addEventListener('load',render,{once:true});}
const all=[...document.querySelectorAll('[data-key]')];
all.forEach(el=>{
 if(el.dataset.money){
  el.addEventListener('blur',()=>{
   let raw=el.value.replace(/[^\d,.-]/g,'').replace(/\./g,'').replace(',','.');
   if(raw!==''&&!isNaN(Number(raw)))el.value=Number(raw).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
  });
 }
 if(el.dataset.mask==='cpf')el.addEventListener('input',()=>{let v=el.value.replace(/\D/g,'').slice(0,11);v=v.replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d{1,2})$/,'$1-$2');el.value=v});
 if(el.dataset.mask==='cep')el.addEventListener('input',()=>{let v=el.value.replace(/\D/g,'').slice(0,8);el.value=v.replace(/(\d{5})(\d)/,'$1-$2')});
 if(el.dataset.mask==='phone')el.addEventListener('input',()=>{let v=el.value.replace(/\D/g,'').slice(0,11);if(v.length>10)v=v.replace(/(\d{2})(\d{5})(\d{4})/,'($1) $2-$3');else if(v.length>6)v=v.replace(/(\d{2})(\d{4})(\d{0,4})/,'($1) $2-$3');else if(v.length>2)v=v.replace(/(\d{2})(\d+)/,'($1) $2');el.value=v});
});
function resetForm(){if(!confirm('Limpar todos os campos desta ficha?'))return;all.forEach(el=>{if(el.type==='checkbox')el.checked=false;else if(!el.readOnly)el.value='';});}
window.saveAndPrint=async()=>{
 const fields={};all.forEach(el=>{fields[el.dataset.key]=el.type==='checkbox'?el.checked:(el.value.trim()||null)});
 if(!fields.p1_nome){alert('Preencha o nome completo do Proponente 1 antes de continuar.');document.querySelector('[data-key="p1_nome"]').focus();return;}
 if(!EDGE_FUNCTION_URL){if(confirm('O envio para a área restrita ainda não foi configurado. Deseja gerar o PDF sem encaminhar os dados?'))window.print();return;}
 try{
  const token=window.turnstile?.getResponse?.()||'';
  if(!token)throw new Error('Confirme a verificação de segurança antes de enviar.');
  const response=await fetch(EDGE_FUNCTION_URL,{method:'POST',headers:{'Content-Type':'application/json','apikey':SUPABASE_PUBLISHABLE_KEY},body:JSON.stringify({fields,turnstileToken:token,website:document.getElementById('website-check').value})});
  const result=await response.json().catch(()=>({}));
  if(!response.ok)throw new Error(result.error||'Não foi possível encaminhar o cadastro.');
  alert('Cadastro encaminhado. A impressão será aberta agora.');window.print();
 }catch(error){if(confirm(`${error.message}\n\nDeseja gerar o PDF sem encaminhar os dados?`))window.print();}
};
</script>
