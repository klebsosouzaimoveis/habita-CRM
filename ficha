<style>
:root{--navy:#062b50;--navy2:#0b416e;--blue:#176eb1;--gold:#e9b83f;--ink:#142b45;--muted:#5b6d80;--line:#b8cadd;--paper:#fff;--bg:#eaf0f5}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);font-family:Arial,Helvetica,sans-serif;color:var(--ink)}
.toolbar{position:sticky;top:0;z-index:50;display:flex;justify-content:center;align-items:center;gap:9px;flex-wrap:wrap;padding:12px;background:var(--navy);box-shadow:0 2px 12px #0002}
