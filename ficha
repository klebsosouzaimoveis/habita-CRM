.doc-title{display:flex;align-items:center;gap:4mm;border-bottom:2px solid var(--gold);padding:1mm 0 3mm}
.doc-title .icon{width:13mm;height:13mm;border-radius:3mm;background:var(--navy);color:white;display:grid;place-items:center;font-size:22pt;font-weight:bold}
