<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow"><title>Área restrita | Fichas Horto Ville III</title>
<style>
:root{font-family:Arial,sans-serif;color:#142b45;background:#eaf0f5}*{box-sizing:border-box}body{margin:0}.wrap{max-width:1100px;margin:36px auto;padding:0 18px}.card{background:white;border-radius:12px;padding:24px;box-shadow:0 4px 20px #1b355022;margin-bottom:18px}h1,h2{color:#062b50;margin-top:0}.muted{color:#5b6d80;font-size:14px}label{display:block;font-weight:700;margin:12px 0 5px}input{width:100%;padding:11px;border:1px solid #b8cadd;border-radius:6px;font-size:15px}button{border:0;border-radius:6px;padding:11px 16px;background:#062b50;color:white;font-weight:700;cursor:pointer;margin-top:14px}.danger{background:#7b2638}.error{color:#a11}.table-wrap{overflow:auto}table{border-collapse:collapse;width:100%;font-size:14px}th,td{text-align:left;padding:10px;border-bottom:1px solid #dce5ed;vertical-align:top}th{color:#062b50}.open-record{background:#176eb1;padding:7px 10px;margin:0}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#f5f8fb;padding:14px;border-radius:7px;font:13px/1.5 ui-monospace,monospace}.top{display:flex;justify-content:space-between;align-items:start;gap:12px}#app[hidden],#login[hidden],#detail[hidden]{display:none}
</style>
</head>
<body><main class="wrap">
<section id="login" class="card"><h1>Área restrita — Fichas recebidas</h1><p class="muted">Entre com a conta administrativa do Supabase para consultar os cadastros enviados pela ficha.</p><form id="login-form"><label for="email">E-mail</label><input id="email" type="email" required autocomplete="username"><label for="password">Senha</label><input id="password" type="password" required autocomplete="current-password"><button>Entrar</button></form><p id="login-message" class="error" role="status"></p></section>
<section id="app" hidden><header class="top card"><div><h1>Fichas recebidas</h1><p class="muted">Somente sua conta pode consultar estes registros.</p></div><button id="logout" class="danger">Sair</button></header><section class="card table-wrap"><table><thead><tr><th>Recebido em</th><th>Proponente</th><th>WhatsApp</th><th>E-mail</th><th></th></tr></thead><tbody id="records"></tbody></table><p id="list-message" class="muted"></p></section><section id="detail" class="card" hidden><h2>Dados completos da ficha</h2><pre id="detail-json"></pre></section></section>
</main>
<script type="module">
import{createClient}from'https://esm.sh/@supabase/supabase-js@2';
const SUPABASE_URL='';
const SUPABASE_ANON_KEY='';
const $=s=>document.querySelector(s);let db=null;
function showSession(session){$('#login').hidden=!!session;$('#app').hidden=!session;if(session)loadRecords();}
async function boot(){if(!SUPABASE_URL||!SUPABASE_ANON_KEY){$('#login-message').textContent='A área ainda não foi configurada com as credenciais públicas do Supabase.';$('#login-form button').disabled=true;return;}db=createClient(SUPABASE_URL,SUPABASE_ANON_KEY);const{data:{session}}=await db.auth.getSession();showSession(session);db.auth.onAuthStateChange((_event,s)=>showSession(s));}
$('#login-form').addEventListener('submit',async e=>{e.preventDefault();$('#login-message').textContent='Validando…';const{error}=await db.auth.signInWithPassword({email:$('#email').value,password:$('#password').value});$('#login-message').textContent=error?.message||'';});
$('#logout').onclick=()=>db.auth.signOut();
async function loadRecords(){if(!db)return;$('#list-message').textContent='Carregando…';const{data,error}=await db.from('pre_venda_cadastros').select('id,nome_proponente,telefone,email,created_at,dados').order('created_at',{ascending:false}).limit(500);if(error){$('#list-message').textContent=`Não foi possível carregar: ${error.message}`;return;}$('#records').replaceChildren();for(const row of data||[]){const tr=document.createElement('tr');for(const value of [new Date(row.created_at).toLocaleString('pt-BR'),row.nome_proponente,row.telefone||'—',row.email||'—']){const td=document.createElement('td');td.textContent=value;tr.append(td);}const td=document.createElement('td'),button=document.createElement('button');button.className='open-record';button.textContent='Abrir';button.onclick=()=>{$('#detail-json').textContent=JSON.stringify(row.dados,null,2);$('#detail').hidden=false;$('#detail').scrollIntoView({behavior:'smooth'});};td.append(button);tr.append(td);$('#records').append(tr);}$('#list-message').textContent=data?.length?`${data.length} cadastro(s) recente(s).`:'Nenhum cadastro recebido.';}
boot();
</script>
</body></html>
